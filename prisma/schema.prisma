// Prisma Schema for HARI HARA Jewellery Works
// PostgreSQL Database Connection

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                 String            @id @default(uuid())
  name               String
  slug               String            @unique
  description        String?
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  metalType          String            @default("GOLD") // "GOLD" or "SILVER"
  purity             String? // e.g., "22K (91.6 KDM)", "18K", "24K", "925 Pure Silver"
  weight             Float? // Weight in grams
  price              Float? // Optional display price
  availabilityStatus String            @default("IN_STOCK") // "IN_STOCK", "MADE_TO_ORDER", "OUT_OF_STOCK"
  publicationStatus  String            @default("PUBLISHED") // "DRAFT", "PUBLISHED"
  isFeatured         Boolean           @default(false)
  isNewArrival       Boolean           @default(false)
  images             ProductImage[]
  enquiries          CustomerEnquiry[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([categoryId])
  @@index([publicationStatus])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([metalType])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model CustomerEnquiry {
  id            String   @id @default(uuid())
  customerName  String
  phone         String
  email         String?
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  message       String
  status        String   @default("NEW") // "NEW", "CONTACTED", "IN_PROGRESS", "RESOLVED"
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@map("customer_enquiries")
}

model ShopSettings {
  id                String   @id @default(uuid())
  shopName          String   @default("HARI HARA Jewellery Works")
  tagline           String?  @default("91.6 KDM Hallmarked Gold & Silver Ornaments")
  logoUrl           String?
  address           String   @default("S.No. 18-7-466/2/B/42, Near Uppuguda Railway Station, Ambica Nagar, Uppuguda, Hyderabad, Telangana - 500053")
  phone             String   @default("+91 98485 43615 / +91 93946 47299")
  whatsappNumber    String   @default("+919848543615")
  email             String?  @default("contact@hariharajewellery.com")
  openingHours      String   @default("Mon - Sat: 10:00 AM - 09:00 PM | Sun: 10:30 AM - 03:00 PM")
  mapUrl            String?
  mapEmbedUrl       String?
  aboutText         String   @db.Text
  heroTitle         String   @default("91.6 KDM Hallmarked Gold & Silver Ornaments")
  heroDescription   String   @db.Text
  heroImageUrl      String?
  footerText        String   @default("HARI HARA Jewellery Works - Trusted Jewellery Craftsmen since 2001. Prop. L. Srinivasa Chary.")
  socialInstagram   String?
  socialFacebook    String?
  socialYoutube     String?
  hallmarkInfo      String?  @db.Text
  returnPolicy      String?  @db.Text
  customOrderPolicy String?  @db.Text
  goldRate22k       Float?   @default(7150)
  goldRate24k       Float?   @default(7800)
  silverRate1g      Float?   @default(96)
  updatedAt         DateTime @updatedAt

  @@map("shop_settings")
}

model ShopService {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  iconName    String?
  imageUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("shop_services")
}
