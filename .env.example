# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harihara_jewellery?schema=public"

# Frontend Origin for CORS and Cookie Security
FRONTEND_URL="http://localhost:5173"

# JWT Secret for Admin Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Initial Admin Credentials (used by prisma/seed.js)
INITIAL_ADMIN_NAME="Sri Hari Hara Admin"
INITIAL_ADMIN_EMAIL="admin@hariharajewellery.com"
INITIAL_ADMIN_PASSWORD="SecureAdminPassword@2026"

# Cloudinary Image Storage (Leave empty for local storage fallback)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="harihara_jewellery"
